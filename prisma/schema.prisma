generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaAssetKind {
  image
  video
}

enum PromotionTriggerType {
  automatic
  coupon
}

enum PromotionRuleType {
  buy_x_get_y
  nth_item_percentage
  volume_discount
  free_shipping
}

enum PromotionStackingMode {
  exclusive
  stackable
}

model ContactLead {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  message   String
  source    String   @default("web-form")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderChildren")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
}

model MediaAsset {
  id                    String            @id @default(cuid())
  storageKey            String            @unique
  publicUrl             String?
  kind                  MediaAssetKind
  mimeType              String?
  altText               String?
  posterUrl             String?
  width                 Int?
  height                Int?
  durationSeconds       Int?
  folderId              String?
  folder                MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  primaryHeroHomePages  HomePageContent[] @relation("HomePrimaryHeroMedia")
  secondaryHeroHomePages HomePageContent[] @relation("HomeSecondaryHeroMedia")
  tertiaryHeroHomePages HomePageContent[] @relation("HomeTertiaryHeroMedia")
  categoryCards         Category[]        @relation("CategoryMediaAsset")
  productCards          Product[]         @relation("ProductMediaAsset")
  brandLogos            Brand[]           @relation("BrandLogoMediaAsset")

  @@index([kind])
  @@index([folderId])
  @@index([createdAt])
}

model Category {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  description     String
  href            String
  isActive        Boolean                @default(true)
  mediaAssetId    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  mediaAsset      MediaAsset?            @relation("CategoryMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  products        Product[]
  productAssignments ProductCategoryAssignment[]
  promotionScopes PromotionCategory[]
  homeSelections  HomeFeaturedCategory[]

  @@index([isActive])
  @@index([mediaAssetId])
  @@index([createdAt])
}

model Product {
  id                 String                @id @default(cuid())
  slug               String                @unique
  name               String
  brand              String                @default("Sin marca")
  brandId            String?
  description        String
  href               String
  badge              String?
  badgeColor         String?
  price              Decimal               @default(0) @db.Decimal(10, 2)
  discountPrice      Decimal?              @db.Decimal(10, 2)
  stock              Int                   @default(0)
  isActive           Boolean               @default(true)
  categoryId         String?
  mediaAssetId       String?
  
  // Sync tracking
  externalId         String?               @unique
  externalSourceId   String?               // Origin system identifier (e.g., "shopify", "custom-api")
  lastSyncedAt       DateTime?
  syncVersion        Int                   @default(0)
  externalMetadata   Json?                 // Store raw external data for audit/enrichment
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  brandRecord        Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryAssignments ProductCategoryAssignment[]
  mediaAsset         MediaAsset?           @relation("ProductMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  promotionScopes    PromotionProduct[]
  homeSelections     HomeFeaturedProduct[]

  @@index([isActive])
  @@index([categoryId])
  @@index([mediaAssetId])
  @@index([createdAt])
  @@index([externalId])
  @@index([externalSourceId])
  @@index([lastSyncedAt])
  @@index([brandId])
}

model Brand {
  id          String     @id @default(cuid())
  name        String     @unique
  mediaAssetId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mediaAsset  MediaAsset? @relation("BrandLogoMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  products    Product[]
  promotionScopes PromotionBrand[]

  @@index([mediaAssetId])
  @@index([createdAt])
}

model ProductCategoryAssignment {
  productId   String
  categoryId  String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId, position])
}

model ProductBadgePreset {
  id        String   @id @default(cuid())
  label     String   @unique
  color     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
}

model Promotion {
  id             String                @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean               @default(true)
  triggerType    PromotionTriggerType  @default(automatic)
  couponCode     String?               @unique
  ruleType       PromotionRuleType
  stackingMode   PromotionStackingMode @default(exclusive)
  priority       Int                   @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  config         Json
  productScopes  PromotionProduct[]
  categoryScopes PromotionCategory[]
  brandScopes    PromotionBrand[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([isActive, triggerType])
  @@index([priority])
  @@index([startsAt, endsAt])
  @@index([createdAt])
}

model PromotionProduct {
  promotionId String
  productId   String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@index([promotionId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@index([promotionId])
}

model PromotionBrand {
  promotionId String
  brandId     String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([promotionId, brandId])
  @@index([brandId])
  @@index([promotionId])
}

model HomeFeaturedCategory {
  id                String          @id @default(cuid())
  homePageContentId String
  categoryId        String
  position          Int
  createdAt         DateTime        @default(now())
  homePageContent   HomePageContent @relation(fields: [homePageContentId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([homePageContentId, categoryId])
  @@unique([homePageContentId, position])
  @@index([categoryId])
}

model HomeFeaturedProduct {
  id                String          @id @default(cuid())
  homePageContentId String
  productId         String
  position          Int
  createdAt         DateTime        @default(now())
  homePageContent   HomePageContent @relation(fields: [homePageContentId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([homePageContentId, productId])
  @@unique([homePageContentId, position])
  @@index([productId])
}

model HomePageContent {
  id                           String      @id @default(cuid())
  slug                         String      @unique @default("home")
  heroEyebrow                  String
  heroTitle                    String
  heroSubtitle                 String
  heroSupportingBadge          String
  heroPrimaryCtaText           String
  heroPrimaryCtaHref           String
  heroSecondaryCtaText         String?
  heroSecondaryCtaHref         String?
  heroMediaId                  String?
  heroSecondaryMediaId         String?
  heroTertiaryMediaId          String?
  featuredCategoriesEyebrow    String
  featuredCategoriesTitle      String
  featuredCategorySelections   HomeFeaturedCategory[]
  featuredProductSelections    HomeFeaturedProduct[]
  featuredCategoriesDescription String
  featuredCategoriesItems      Json
  featuredProductsEyebrow      String
  featuredProductsTitle        String
  featuredProductsDescription  String
  featuredProductsItems        Json
  trustHighlightsEyebrow       String
  trustHighlightsTitle         String
  trustHighlightsDescription   String
  trustHighlightsItems         Json
  ctaEyebrow                   String
  ctaTitle                     String
  ctaDescription               String
  ctaPrimaryCtaText            String
  ctaPrimaryCtaHref            String
  ctaSecondaryCtaText          String?
  ctaSecondaryCtaHref          String?
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt
  heroMedia                    MediaAsset? @relation("HomePrimaryHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  heroSecondaryMedia           MediaAsset? @relation("HomeSecondaryHeroMedia", fields: [heroSecondaryMediaId], references: [id], onDelete: SetNull)
  heroTertiaryMedia            MediaAsset? @relation("HomeTertiaryHeroMedia", fields: [heroTertiaryMediaId], references: [id], onDelete: SetNull)

  @@index([heroMediaId])
  @@index([heroSecondaryMediaId])
  @@index([heroTertiaryMediaId])
  @@index([createdAt])
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum OrderSource {
  web
  api
  manual
}

enum OrderNoteVisibility {
  internal
  customer
}

enum WebhookEventStatus {
  pending
  delivered
  failed
  retrying
}

enum EmailStatus {
  queued
  sent
  delivered
  bounced
  failed
  skipped
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  clerkUserId       String?
  guestEmail        String?
  guestPhone        String?
  status            OrderStatus @default(pending)
  paymentStatus     PaymentStatus @default(pending)
  trackingNumber    String?
  trackingUrl       String?
  source            OrderSource @default(web)
  externalOrderId   String?     @unique
  syncedAt          DateTime?
  firstName         String
  lastName          String
  address           String
  apartment         String?
  province          String
  city              String
  phone             String
  idNumber          String?
  shippingMethodId  String?
  shippingMethodName String
  paymentMethodId   String?
  paymentMethodName String
  couponCode        String?
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingCost      Decimal     @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  checkoutNotes     String?     @map("notes")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  notes             OrderNote[]
  timeline          OrderTimeline[]
  webhookEvents     WebhookEvent[]

  @@index([clerkUserId])
  @@index([guestEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([source])
  @@index([syncedAt])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  name          String
  brand         String
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  quantity      Int
  imageUrl      String?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderNote {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content    String
  visibility OrderNoteVisibility @default(internal)
  createdBy  String?
  createdAt  DateTime            @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType   String
  description String
  metadata    Json?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

model ExternalApiConfig {
  id            String   @id @default("default")
  webhookUrl    String?
  secretToken   String?
  enabled       Boolean  @default(false)
  retryAttempts Int      @default(3)
  timeoutMs     Int      @default(10000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookEvent {
  id                 String             @id @default(cuid())
  orderId            String
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType          String
  payload            Json
  status             WebhookEventStatus @default(pending)
  attemptCount       Int                @default(0)
  lastAttemptAt      DateTime?
  lastResponseStatus Int?
  lastResponseBody   String?
  lastError          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  subject     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model EmailLog {
  id           String      @id @default(cuid())
  recipient    String
  templateKey  String
  subject      String
  status       EmailStatus @default(queued)
  resendId     String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([recipient])
  @@index([templateKey])
  @@index([status])
  @@index([createdAt])
}

model EmailSettings {
  id          String   @id @default("default")
  adminEmails String[]
  testMode    Boolean  @default(true)
  testEmails  String[]
  fromName    String   @default("Dermatologika")
  fromEmail   String   @default("onboarding@resend.dev")
  replyTo     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   @unique
  price         Decimal  @default(0) @db.Decimal(10, 2)
  estimatedDays String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([type])
}

model PaymentMethod {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String   @unique
  instructions String?  @db.Text
  initialOrderStatus String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}
