generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaAssetKind {
  image
  video
}

enum PromotionTriggerType {
  automatic
  coupon
}

enum PromotionRuleType {
  buy_x_get_y
  nth_item_percentage
  volume_discount
  free_shipping
}

enum PromotionStackingMode {
  exclusive
  stackable
}

model ContactLead {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  message   String
  source    String   @default("web-form")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderChildren")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
}

model MediaAsset {
  id                     String            @id @default(cuid())
  storageKey             String            @unique
  publicUrl              String?
  kind                   MediaAssetKind
  mimeType               String?
  altText                String?
  posterUrl              String?
  width                  Int?
  height                 Int?
  durationSeconds        Int?
  folderId               String?
  folder                 MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  primaryHeroHomePages   HomePageContent[] @relation("HomePrimaryHeroMedia")
  secondaryHeroHomePages HomePageContent[] @relation("HomeSecondaryHeroMedia")
  tertiaryHeroHomePages  HomePageContent[] @relation("HomeTertiaryHeroMedia")
  categoryCards          Category[]        @relation("CategoryMediaAsset")
  productCards           Product[]         @relation("ProductMediaAsset")
  brandLogos             Brand[]           @relation("BrandLogoMediaAsset")
  collections            Collection[]      @relation("CollectionMediaAsset")
  nutritionalInfoProducts Product[]        @relation("ProductNutritionalInfoMedia")
  ingredientMediaAssets   ProductIngredient[] @relation("IngredientMediaAsset")
  variantMediaAssets      ProductVariant[]    @relation("VariantMediaAsset")
  productGalleryImages    ProductGalleryImage[] @relation("ProductGalleryMediaAsset")
  productUsageSteps       ProductUsageStep[]  @relation("ProductUsageStepMediaAsset")
  pickupLocationLogos     PickupLocation[]    @relation("PickupLocationLogoMedia")

  @@index([kind])
  @@index([folderId])
  @@index([createdAt])
}

model Category {
  id                    String                      @id @default(cuid())
  slug                  String                      @unique
  name                  String
  description           String
  href                  String
  isActive              Boolean                     @default(true)
  mediaAssetId          String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  mediaAsset            MediaAsset?                 @relation("CategoryMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  products              Product[]
  productAssignments    ProductCategoryAssignment[]
  promotionScopes       PromotionCategory[]
  homeSelections        HomeFeaturedCategory[]
  collectionAssignments CollectionCategory[]

  @@index([isActive])
  @@index([mediaAssetId])
  @@index([createdAt])
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  brand           String   @default("Sin marca")
  brandId         String?
  description     String
  shortDescription String  @default("")
  longDescription String   @default("")
  preTitle        String?
  slogan          String?
  href            String
  badge           String?
  badgeColor      String?
  price           Decimal  @default(0) @db.Decimal(10, 2)
  discountPrice   Decimal? @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  stock           Int      @default(0)
  isActive        Boolean  @default(true)
  categoryId      String?
  mediaAssetId    String?
  productColor    String?   // Hex color for product gradient bg
  nutritionalInfoImageId String?

  // Sync tracking
  externalId       String?   @unique
  externalSourceId String? // Origin system identifier (e.g., "shopify", "custom-api")
  lastSyncedAt     DateTime?
  syncVersion      Int       @default(0)
  externalMetadata Json? // Store raw external data for audit/enrichment

  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  brandRecord           Brand?                      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category              Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryAssignments   ProductCategoryAssignment[]
  mediaAsset            MediaAsset?                 @relation("ProductMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  promotionScopes       PromotionProduct[]
  homeSelections        HomeFeaturedProduct[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  restockAlerts         RestockAlert[]
  subscriptions         Subscription[]
  collectionAssignments   CollectionProduct[]
  variants                ProductVariant[]
  ingredients             ProductIngredient[]
  benefits                ProductBenefit[]
  galleryImages           ProductGalleryImage[]
  usageSteps              ProductUsageStep[]
  trustBadges             ProductTrustBadge[]
  pickupLocations         ProductPickupLocation[]
  nutritionalInfoImage    MediaAsset?                 @relation("ProductNutritionalInfoMedia", fields: [nutritionalInfoImageId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([categoryId])
  @@index([mediaAssetId])
  @@index([createdAt])
  @@index([externalId])
  @@index([externalSourceId])
  @@index([lastSyncedAt])
  @@index([brandId])
  @@index([isActive, discountPercent])
  @@index([nutritionalInfoImageId])
}

model Brand {
  id              String           @id @default(cuid())
  name            String           @unique
  mediaAssetId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  mediaAsset      MediaAsset?      @relation("BrandLogoMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  products        Product[]
  promotionScopes PromotionBrand[]

  @@index([mediaAssetId])
  @@index([createdAt])
}

model ProductCategoryAssignment {
  productId  String
  categoryId String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId, position])
}

model ProductBadgePreset {
  id        String   @id @default(cuid())
  label     String   @unique
  color     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String
  price         Decimal  @default(0) @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  mediaAssetId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset? @relation("VariantMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([mediaAssetId])
}

model ProductIngredient {
  id           String      @id @default(cuid())
  productId    String
  name         String
  description  String?
  mediaAssetId String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation("IngredientMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([mediaAssetId])
}

model ProductBenefit {
  id        String   @id @default(cuid())
  productId String
  text      String
  iconKey   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductGalleryImage {
  id           String      @id @default(cuid())
  productId    String
  mediaAssetId String
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation("ProductGalleryMediaAsset", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductUsageStep {
  id           String      @id @default(cuid())
  productId    String
  stepNumber   Int
  text         String
  mediaAssetId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation("ProductUsageStepMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ProductTrustBadge {
  id        String   @id @default(cuid())
  productId String
  text      String
  iconKey   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PickupLocation {
  id            String   @id @default(cuid())
  name          String
  address       String
  directionsUrl String?
  logoMediaId   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  logoMedia     MediaAsset? @relation("PickupLocationLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  products      ProductPickupLocation[]

  @@index([isActive])
  @@index([logoMediaId])
}

model ProductPickupLocation {
  productId        String
  pickupLocationId String
  createdAt        DateTime @default(now())
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  pickupLocation   PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade)

  @@id([productId, pickupLocationId])
  @@index([pickupLocationId])
}

model Collection {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  excerpt      String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  mediaAssetId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaAsset MediaAsset?          @relation("CollectionMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  products   CollectionProduct[]
  categories CollectionCategory[]

  @@index([isActive])
  @@index([slug])
  @@index([sortOrder])
  @@index([mediaAssetId])
  @@index([createdAt])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
}

model CollectionCategory {
  collectionId String
  categoryId   String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionId, categoryId])
  @@index([categoryId])
  @@index([collectionId, position])
}

model Promotion {
  id             String                @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean               @default(true)
  triggerType    PromotionTriggerType  @default(automatic)
  couponCode     String?               @unique
  ruleType       PromotionRuleType
  stackingMode   PromotionStackingMode @default(exclusive)
  priority       Int                   @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  config         Json
  productScopes  PromotionProduct[]
  categoryScopes PromotionCategory[]
  brandScopes    PromotionBrand[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([isActive, triggerType])
  @@index([priority])
  @@index([startsAt, endsAt])
  @@index([createdAt])
}

model PromotionProduct {
  promotionId String
  productId   String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@index([promotionId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@index([promotionId])
}

model PromotionBrand {
  promotionId String
  brandId     String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([promotionId, brandId])
  @@index([brandId])
  @@index([promotionId])
}

model HomeFeaturedCategory {
  id                String          @id @default(cuid())
  homePageContentId String
  categoryId        String
  position          Int
  createdAt         DateTime        @default(now())
  homePageContent   HomePageContent @relation(fields: [homePageContentId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([homePageContentId, categoryId])
  @@unique([homePageContentId, position])
  @@index([categoryId])
}

model HomeFeaturedProduct {
  id                String          @id @default(cuid())
  homePageContentId String
  productId         String
  position          Int
  createdAt         DateTime        @default(now())
  homePageContent   HomePageContent @relation(fields: [homePageContentId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([homePageContentId, productId])
  @@unique([homePageContentId, position])
  @@index([productId])
}

model HomePageContent {
  id                            String                 @id @default(cuid())
  slug                          String                 @unique @default("home")
  heroEyebrow                   String
  heroTitle                     String
  heroSubtitle                  String
  heroSupportingBadge           String
  heroPrimaryCtaText            String
  heroPrimaryCtaHref            String
  heroSecondaryCtaText          String?
  heroSecondaryCtaHref          String?
  heroMediaId                   String?
  heroSecondaryMediaId          String?
  heroTertiaryMediaId           String?
  featuredCategoriesEyebrow     String
  featuredCategoriesTitle       String
  featuredCategorySelections    HomeFeaturedCategory[]
  featuredProductSelections     HomeFeaturedProduct[]
  featuredCategoriesDescription String
  featuredCategoriesItems       Json
  featuredProductsEyebrow       String
  featuredProductsTitle         String
  featuredProductsDescription   String
  featuredProductsItems         Json
  trustHighlightsEyebrow        String
  trustHighlightsTitle          String
  trustHighlightsDescription    String
  trustHighlightsItems          Json
  ctaEyebrow                    String
  ctaTitle                      String
  ctaDescription                String
  ctaPrimaryCtaText             String
  ctaPrimaryCtaHref             String
  ctaSecondaryCtaText           String?
  ctaSecondaryCtaHref           String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  heroMedia                     MediaAsset?            @relation("HomePrimaryHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  heroSecondaryMedia            MediaAsset?            @relation("HomeSecondaryHeroMedia", fields: [heroSecondaryMediaId], references: [id], onDelete: SetNull)
  heroTertiaryMedia             MediaAsset?            @relation("HomeTertiaryHeroMedia", fields: [heroTertiaryMediaId], references: [id], onDelete: SetNull)

  @@index([heroMediaId])
  @@index([heroSecondaryMediaId])
  @@index([heroTertiaryMediaId])
  @@index([createdAt])
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum AbandonedCartStatus {
  active
  recovered
  expired
}

enum ReferralRewardType {
  percent_discount
  fixed_amount
}

enum SubscriptionFrequency {
  days_15
  days_30
  days_45
  days_60
  days_90
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  expired
}

enum OrderSource {
  web
  api
  manual
}

enum OrderNoteVisibility {
  internal
  customer
}

enum AddressType {
  SHIPPING
  BILLING
}

enum WebhookEventStatus {
  pending
  delivered
  failed
  retrying
}

enum EmailStatus {
  queued
  sent
  delivered
  bounced
  failed
  skipped
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  clerkUserId        String?
  guestEmail         String?
  guestPhone         String?
  status             OrderStatus     @default(pending)
  paymentStatus      PaymentStatus   @default(pending)
  trackingNumber     String?
  trackingUrl        String?
  source             OrderSource     @default(web)
  externalOrderId    String?         @unique
  syncedAt           DateTime?
  firstName          String
  lastName           String
  address            String
  apartment          String?
  province           String
  city               String
  phone              String
  idNumber           String?
  shippingMethodId   String?
  shippingMethodName String
  paymentMethodId    String?
  paymentMethodName  String
  couponCode         String?
  subtotal           Decimal         @db.Decimal(10, 2)
  shippingCost       Decimal         @db.Decimal(10, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(10, 2)
  total              Decimal         @db.Decimal(10, 2)
  checkoutNotes      String?         @map("notes")
  archived           Boolean         @default(false)
  billingFirstName   String?
  billingLastName    String?
  billingAddress     String?
  billingApartment   String?
  billingProvince    String?
  billingCity        String?
  billingPhone       String?
  billingRuc         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  items              OrderItem[]
  notes              OrderNote[]
  timeline           OrderTimeline[]
  webhookEvents      WebhookEvent[]

  @@index([clerkUserId])
  @@index([guestEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([source])
  @@index([syncedAt])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  name          String
  brand         String
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  quantity      Int
  imageUrl      String?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderNote {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content    String
  visibility OrderNoteVisibility @default(internal)
  createdBy  String?
  createdAt  DateTime            @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType   String
  description String
  metadata    Json?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

model ExternalApiConfig {
  id            String   @id @default("default")
  webhookUrl    String?
  secretToken   String?
  enabled       Boolean  @default(false)
  retryAttempts Int      @default(3)
  timeoutMs     Int      @default(10000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookEvent {
  id                 String             @id @default(cuid())
  orderId            String
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType          String
  payload            Json
  status             WebhookEventStatus @default(pending)
  attemptCount       Int                @default(0)
  lastAttemptAt      DateTime?
  lastResponseStatus Int?
  lastResponseBody   String?
  lastError          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  subject     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model EmailLog {
  id           String      @id @default(cuid())
  recipient    String
  templateKey  String
  subject      String
  status       EmailStatus @default(queued)
  resendId     String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([recipient])
  @@index([templateKey])
  @@index([status])
  @@index([createdAt])
}

model EmailSettings {
  id          String   @id @default("default")
  adminEmails String[]
  testMode    Boolean  @default(true)
  testEmails  String[]
fromName String @default("Eterna Vida")
  fromEmail   String   @default("onboarding@resend.dev")
  replyTo     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   @unique
  price         Decimal  @default(0) @db.Decimal(10, 2)
  estimatedDays String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([type])
}

model PaymentMethod {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  type               String   @unique
  instructions       String?  @db.Text
  initialOrderStatus String?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id                 String       @id @default(cuid())
  productId          String
  clerkUserId        String
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(pending)
  adminResponse      String?
  adminRespondedAt   DateTime?
  imageUrls          String[]     @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, clerkUserId])
  @@index([productId])
  @@index([clerkUserId])
  @@index([status])
  @@index([isVerifiedPurchase])
  @@index([createdAt])
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model WishlistItem {
  id          String   @id @default(cuid())
  clerkUserId String
  productId   String
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clerkUserId, productId])
  @@index([clerkUserId])
  @@index([productId])
  @@index([createdAt])
}

// ─── Addresses ──────────────────────────────────────────────────────────────

model Address {
  id          String      @id @default(cuid())
  clerkUserId String
  type        AddressType
  firstName   String
  lastName    String
  address     String
  apartment   String?
  province    String
  city        String
  phone       String
  idNumber    String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clerkUserId])
  @@index([clerkUserId, type])
  @@index([isDefault])
}

// ─── Abandoned Cart ──────────────────────────────────────────────────────────

model AbandonedCart {
  id             String              @id @default(cuid())
  clerkUserId    String?
  guestEmail     String?
  guestPhone     String?
  cartData       Json
  status         AbandonedCartStatus @default(active)
  lastActivityAt DateTime
  recoveryStep   Int                 @default(0)
  recoveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  recoveryLogs AbandonedCartRecoveryLog[]

  @@index([clerkUserId])
  @@index([guestEmail])
  @@index([status])
  @@index([lastActivityAt])
  @@index([createdAt])
}

model AbandonedCartRecoveryLog {
  id              String    @id @default(cuid())
  abandonedCartId String
  step            Int
  emailSentAt     DateTime
  clickedAt       DateTime?
  convertedAt     DateTime?

  abandonedCart AbandonedCart @relation(fields: [abandonedCartId], references: [id], onDelete: Cascade)

  @@index([abandonedCartId])
  @@index([step])
  @@index([emailSentAt])
}

model AbandonedCartSettings {
  id               String   @id @default("default")
  isEnabled        Boolean  @default(true)
  steps            Json
  maxRecoverySteps Int      @default(3)
  includeDiscount  Boolean  @default(false)
  discountPercent  Decimal? @db.Decimal(5, 2)
  couponPrefix     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Restock Alerts ──────────────────────────────────────────────────────────

model RestockAlert {
  id         String    @id @default(cuid())
  email      String
  productId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId])
  @@index([productId])
  @@index([notifiedAt])
  @@index([createdAt])
}

model RestockAlertSettings {
  id                  String   @id @default("default")
  isEnabled           Boolean  @default(true)
  emailSubject        String   @default("¡Tu producto está disponible!")
  maxAlertsPerProduct Int      @default(500)
  expiresAfterDays    Int      @default(90)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Referral Program ────────────────────────────────────────────────────────

model ReferralProgram {
  id                  String             @id @default("default")
  isEnabled           Boolean            @default(true)
  referrerRewardType  ReferralRewardType @default(percent_discount)
  referrerRewardValue Decimal            @db.Decimal(5, 2)
  referredRewardType  ReferralRewardType @default(percent_discount)
  referredRewardValue Decimal            @db.Decimal(5, 2)
  couponDurationDays  Int?
  maxReferralsPerUser Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model ReferralCode {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  code        String   @unique
  usesCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrals Referral[]

  @@index([code])
  @@index([clerkUserId])
  @@index([isActive])
}

model Referral {
  id             String    @id @default(cuid())
  referralCodeId String
  referredUserId String?
  referredEmail  String
  status         String    @default("pending")
  referrerCoupon String?
  referredCoupon String?
  rewardedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@index([referredEmail])
  @@index([status])
  @@index([createdAt])
}

// ─── Subscriptions ───────────────────────────────────────────────────────────

model Subscription {
  id                 String                @id @default(cuid())
  clerkUserId        String
  productId          String
  frequency          SubscriptionFrequency
  quantity           Int                   @default(1)
  status             SubscriptionStatus    @default(active)
  nextOrderAt        DateTime
  lastOrderAt        DateTime?
  lastOrderId        String?
  totalCycles        Int                   @default(0)
  maxCycles          Int?
  paymentMethodToken String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  SubscriptionOrder[]

  @@index([clerkUserId])
  @@index([productId])
  @@index([status])
  @@index([nextOrderAt])
  @@index([createdAt])
}

model SubscriptionOrder {
  id             String   @id @default(cuid())
  subscriptionId String
  orderId        String
  cycleNumber    Int
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([orderId])
}

model SubscriptionSettings {
  id                      String   @id @default("default")
  reminderEnabled         Boolean  @default(true)
  reminderDaysBefore      Int      @default(3)
  autoChargeEnabled       Boolean  @default(false)
  reminderEmailSubject    String?
  maxSubscriptionsPerUser Int      @default(10)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
